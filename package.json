{
  "name": "ptnmove",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/core.test.ts test/ui.test.ts test/dsp.test.ts test/persist.test.ts",
    "typecheck": "tsc --noEmit",
    "bench": "node scripts/bench.ts",
    "build": "esbuild src/host/main.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=ui.js",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
